# Quant News Tracker - Environment Configuration

# LLM Configuration
LM_STUDIO_URL=http://localhost:1234/v1
OPENAI_API_KEY=sk-your-key-here

# News API (optional - for enhanced news coverage)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# App Settings
DEBUG=true
PORT=8050

# Database (Postgres)
DATABASE_URL=postgresql://quantnews:quantnews@localhost:5433/quantnews

# Object Storage (S3-compatible — MinIO for local, Railway for prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=quantnews-reports

# ── Cygnet SSO ──────────────────────────────────────────────────────────────
# Signing secret for session cookies and the portal SSO handoff.
# MUST be the SAME value across all Cygnet sister apps (CygnetResearchTerminal,
# QuantNews, the portal) — that shared secret IS the SSO trust.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_COOKIE_SECRET_KEY=change-me-shared-across-cygnet-apps
# Set false only for local http development; Railway (https) keeps true.
COOKIE_SECURE=true
# Shared auth Postgres holding the Cygnet `users` + `sessions` tables
# (CygnetResearchTerminal's schema). Unset locally to use DATABASE_URL —
# the tables are created automatically on first startup.
# AUTH_DATABASE_URL=postgresql://user:pass@shared-auth-host:5432/cygnet_auth

# Optional tuning
# LLM_TIMEOUT=180
# STOCK_FETCH_CONCURRENCY=4
# NEWS_FETCH_CONCURRENCY=2

# Email notifications for scheduled runs (morning calls + evening results).
# Same Microsoft Graph app registration CygnetResearchTerminal's cron_jobs
# uses — set the identical values in both services and one Azure app covers
# both. All five must be present or notifications stay off.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
NOTIFY_FROM_EMAIL="quantnews-notifications@cygnetsystems.us"
NOTIFY_TO_EMAIL="umar.jahangir@cygnetsystems.us,vasi.rahaman@cygnetsystems.us"

# Scheduler
# Per-PROCESS stand-down, not a global switch: leave it unset in the deployed
# service. Set it to 0 only when a process shares the production database but
# must not execute jobs — running the app on your laptop against prod, say,
# where you do not want your machine winning the lock and paying for an
# analysis. To stop a job everywhere, disable the job itself in
# History -> Scheduled Jobs; that is a different intent and a different blast
# radius. A stood-down process reports scheduling_disabled on /healthz and
# stays healthy, so it is distinguishable from a crashed scheduler.
SCHEDULER_ENABLED=0

# ── Everything else the code reads (all optional; defaults in config.py) ────
# LLM providers / roles
# ANTHROPIC_API_KEY=                  # required for any claude-* model (report, synthesis, fallback)
# REPORT_MODEL=gpt-5.6-luna           # per-symbol research + portfolio report
# RECOMMENDATIONS_MODEL=claude-sonnet-5
# RECOMMENDATIONS_PROVIDER=anthropic
# RECOMMENDATIONS_FALLBACK_MODEL=claude-sonnet-4-6   # re-asked once if the primary fails
# RECOMMENDATIONS_MAX_TOKENS=5000
# RECOMMENDATIONS_REASONING_EFFORT=high
# RESEARCH_BACKEND=single_agent
# News window (Run dialog / scheduler job / CLI override these per run)
# NEWS_FILTER_MODE=lookback           # lookback | overnight
# NEWS_OVERNIGHT_START_ET=16:00
# NEWS_OVERNIGHT_END_ET=09:30
# NEWS_OVERNIGHT_RELEVANCE=0.7
# NEWS_MAX_ARTICLES=500               # per-symbol cap on a run's window, 0 = all
# NEWS_PROMPT_ARTICLES=25             # articles the research prompt reads (spread across the window)
# NEWS_SYNTHESIS_ARTICLES=40          # articles the portfolio report reads, total
# ALPHA_VANTAGE_CALLS_PER_MIN=70
# Server / database
# HOST=0.0.0.0
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_ECHO_SQL=false
# HISTORICAL_DATABASE_URL=            # cron-jobs-service EDGAR history bridge
# TERMINAL_HISTORY_DATABASE_URL=      # CygnetResearchTerminal history (options, quality)
# Sessions (shared with the other Cygnet apps)
# COOKIE_DOMAIN=
# SESSION_COOKIE_NAME=
# SESSION_COOKIE_SALT=
# Misc
# RATE_LIMIT_STATE_DIR=
# REFLECTION_LOG_PATH=
# S3_REGION=                          # AWS_* variables are accepted as the Railway fallback set
